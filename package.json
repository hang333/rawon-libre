{
    "name": "rawon-libre",
    "version": "4.6.2",
    "description": "A simple powerful Discord music (multi-)bot built to fulfill your production desires. Easy to use, with no coding required. The AGPL-3.0 community continuation of Rawon.",
    "license": "AGPL-3.0",
    "author": "Stegripe Development <support@stegripe.org>",
    "contributors": ["hang333 <jonathan.goh333@gmail.com> (https://github.com/hang333)"],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hang333/rawon-libre.git"
    },
    "bugs": {
        "url": "https://github.com/hang333/rawon-libre/issues"
    },
    "homepage": "https://github.com/hang333/rawon-libre#readme",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "build": "pnpm lint && rimraf dist && pnpm exec swc src -d dist --strip-leading-paths",
        "tscompile": "tsc --build tsconfig.json",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "start": "node --es-module-specifier-resolution=node -r dotenv/config . | pino-pretty -t \"SYS:yyyy-MM-dd HH:mm:ss\"",
        "dev": "pnpm build && pnpm start"
    },
    "engines": {
        "node": ">=22.14.0",
        "npm": ">=7.0.0"
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@puppeteer/browsers": "^3.2.6",
        "@sapphire/decorators": "^6.2.0",
        "@sapphire/framework": "^5.5.1",
        "@sapphire/utilities": "^3.18.3",
        "@stegripe/command-context": "^1.2.0",
        "@stegripe/pino-logger": "^1.2.0",
        "@swc/cli": "0.8.2",
        "@swc/core": "1.16.22",
        "@types/better-sqlite3": "^9",
        "better-sqlite3": "^13.0.3",
        "date-fns": "4.4.0",
        "discord.js": "14.28.1",
        "dotenv": "18.0.10",
        "ffmpeg-static": "^5.3.0",
        "got": "16.2.0",
        "i18n": "0.15.4",
        "opusscript": "0.1.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "prism-media": "1.3.5",
        "puppeteer": "^25.16.0",
        "puppeteer-core": "^25.16.0",
        "soundcloud.ts": "^0.7.4",
        "tslib": "2.9.1",
        "youtubei": "1.8.17",
        "zip-lib": "^1.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@stegripe/biomejs-config": "^1.1.0",
        "@types/i18n": "0.13.12",
        "@types/node": "^26",
        "rimraf": "^6.1.4",
        "typescript": "7.0.2"
    },
    "optionalDependencies": {
        "@snazzah/davey": "^0.1.12"
    }
}
