# Optional and/or developer configuration for Rawon Discord Bot
# Copy this file to dev.env and fill in your values

# Bot-specific settings (embed color, yes/no emoji, splash, alt prefix, default volume, selection type, audio cache)
# are managed via the setup command (developer-only) and stored in the database.
# Use: <prefix>setup view

# Enable/disable prefix commands
# Available: yes, no
# Default: yes
ENABLE_PREFIX=""

# Enable/disable slash commands
# Available: yes, no
# Default: yes
ENABLE_SLASH_COMMAND=""

# Enable sharding for large bots (single token mode only)
# Available: yes, no
# Default: no
ENABLE_SHARDING=""

# Port for Chrome DevTools remote debugging proxy
# Used for the login command to access DevTools from a remote machine/host
# Default: 3000
DEVTOOLS_PORT=""

# Path to Chrome/Chromium executable for Google login
# Leave empty for auto-detection
# Example: /usr/bin/chromium-browser, /usr/bin/google-chrome
CHROMIUM_PATH=""

# Where a plain-text search (not a link) looks for tracks
# youtube-music: the YouTube Music catalogue first, YouTube videos when it finds nothing
# youtube: YouTube videos only
# Available: youtube-music, youtube
# Default: youtube-music
SEARCH_PROVIDER=""

# Base URL for the small images used in embeds. It must serve these three files:
#   icon.png, information.png, question_mark.png
# Leave empty to use the bot's own avatar instead
# Example: https://cdn.example.com/rawon
ASSET_BASE_URL=""

# Hastebin-compatible paste server for eval output that is too long for an embed
# Leave empty to attach long output to the reply as a file instead
# Example: https://paste.example.com
HASTE_URL=""

# Base URL of the lyrics API used when STEGRIPE_API_LYRICS_TOKEN is set
# Default: https://api.stegripe.org
STEGRIPE_API_URL=""

# Environment mode
# Available: production, development
# Default: production
NODE_ENV="production"

# Enable debug logging
# Available: yes, no
# Default: no
DEBUG_MODE=""
